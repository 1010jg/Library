# ==========================================
# Backend Environment Configuration Example
# ==========================================

PORT=4000
NODE_ENV=development

# Mongoose / MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/library_db
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/library_db?retryWrites=true&w=majority

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
